msgstr "Las comunicaciones con Dropbox requieren que [allow_url_fopen] se establezca en 1 en el archivo php.ini."

#: template/admin_pages/packages/scan/items/setup/system.php:98
msgid "cURL - Dropbox"
msgstr "cURL - Dropbox"

#: template/admin_pages/packages/scan/items/setup/system.php:101
